DATABASE_URL=postgresql+asyncpg://appuser:changeme@localhost:5432/appdb
TEST_DATABASE_URL=postgresql+asyncpg://appuser:changeme@localhost:5432/appdb_test
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=change-me-to-a-32-char-minimum-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10

# SMTP / Email (leave SMTP_USER empty to disable email sending in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Moments
SMTP_FROM_EMAIL=your-email@gmail.com
APP_URL=http://localhost:3000
