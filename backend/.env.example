DATABASE_URL=postgresql+asyncpg://appuser:changeme@localhost:5432/appdb
TEST_DATABASE_URL=postgresql+asyncpg://appuser:changeme@localhost:5432/appdb_test
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=change-me-to-a-32-char-minimum-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10

APP_URL=http://localhost:3000

# Multi-tenant: base domain for subdomains ({slug}.nihulo.app)
APP_DOMAIN=localhost:3000
# Email of the first system super-admin (set once; leave empty in dev to skip auto-promotion)
SYSTEM_ADMIN_EMAIL=

# Cookie security: set True in production (requires HTTPS)
COOKIE_SECURE=False

# NOTE: Platform SMTP and OpenAI API key are configured via the sys-admin
# settings page (/settings) — they are stored in the system_settings DB table,
# not as environment variables.
