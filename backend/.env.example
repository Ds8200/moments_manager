DATABASE_URL=postgresql+asyncpg://appuser:changeme@localhost:5432/appdb
TEST_DATABASE_URL=postgresql+asyncpg://appuser:changeme@localhost:5432/appdb_test
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
SECRET_KEY=change-me-to-a-32-char-minimum-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Email via Brevo HTTP API (leave BREVO_API_KEY empty to disable email in dev)
BREVO_API_KEY=your-brevo-api-key-here
EMAIL_FROM_NAME=Management System
EMAIL_FROM=exemple@gmail.com
APP_URL=http://localhost:3000

# Multi-tenant: base domain for subdomains ({slug}.moments.app)
APP_DOMAIN=localhost:3000
# Email of the first system super-admin (set once; leave empty in dev to skip auto-promotion)
SYSTEM_ADMIN_EMAIL=

# AI via OpenAI (get key at platform.openai.com — ~$0.30/month for typical use)
OPENAI_API_KEY=your-openai-api-key-here
